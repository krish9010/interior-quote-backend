# Copy this file to .env (or set these as real environment variables) and fill in
# the values from your Azure AD app registration. See README.md for the
# step-by-step registration walkthrough.

# App registration -> Overview
AZURE_CLIENT_ID=

# App registration -> Certificates & secrets -> new client secret (the VALUE, not the ID)
AZURE_CLIENT_SECRET=

# App registration -> Overview -> Directory (tenant) ID.
# Use "common" instead if you want to allow sign-in from any Microsoft account/org.
AZURE_TENANT_ID=

# Comma-separated list of emails that should get "staff" access (full access,
# can create quotations). Everyone else who signs in successfully is treated
# as a "client" and can only view quotations where the client email matches
# their own sign-in email.
STAFF_EMAILS=owner@yourcompany.com,designer1@yourcompany.com

# Random long string used to sign the session cookie. Generate one with:
# python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Anthropic API key for the AI features (item suggestions, proposal text,
# client chat, floor plan reading, design concepts). Get one at
# https://console.anthropic.com/settings/keys
# If left blank, the AI endpoints return a 503 but the rest of the app works normally.
ANTHROPIC_API_KEY=

# TEMPORARY, for testing only: set to "true" to enable /api/mobile/dev-login,
# which lets the mobile app sign in with just a typed email -- no real
# Microsoft account needed. Useful while Azure AD mobile setup is blocked.
# Set back to "false" (or remove this line) once real Microsoft sign-in works,
# so nobody can access the app without a real Microsoft account.
ALLOW_DEV_LOGIN=false

# ---- Database (optional but recommended) ----
# Without this, quotations/clients live only in memory and are wiped every
# time the server restarts (including Render's free-tier auto-sleep).
#
# Postgres (recommended): if you attach a Render Postgres instance to this
# service, Render sets DATABASE_URL automatically -- you don't need to type
# it in yourself. See README for the "Add a database" steps.
DATABASE_URL=

# ---- SQL Server (alternative, only if you later move to a paid plan) ----
# Needs the ODBC driver + a Docker-based Render deploy -- see README.
# Leave blank if you're using DATABASE_URL above.
SQLSERVER_HOST=
SQLSERVER_PORT=1433
SQLSERVER_DB=
SQLSERVER_USER=
SQLSERVER_PASSWORD=
# Set to "true" to use Windows Integrated Auth instead of SQLSERVER_USER/PASSWORD
SQLSERVER_TRUSTED=false
# Must match an ODBC driver installed on this machine (see README)
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
# "no" only for local dev against a server without a trusted TLS cert
SQLSERVER_ENCRYPT=yes
SQLSERVER_TRUST_SERVER_CERTIFICATE=no
